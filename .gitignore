# Build output
bin/
obj/
artifacts/
[Bb]uild/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Native build trees
external/**/build/
native-build/
runtimes/

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Benchmark output. These are machine-specific measurements, not sources: they
# were committed once and would otherwise be rewritten by every local run,
# producing diffs that record the CPU that happened to be free. Published
# numbers belong in docs/benchmarks.md, where they can be dated and attributed.
BenchmarkDotNet.Artifacts/

# Test and coverage output
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/

# NuGet's convention for files a package contributes to the consumer's build is
# a folder called build/, which the rule near the top of this file ignores along
# with every CMake output directory. Box3D.NET.Native's is source, not output:
# without this line the iOS .targets is never committed, and the package ships
# looking complete while no iOS application can link against it.
!src/Box3D.NET.Native/build/

# OS noise
.DS_Store
Thumbs.db

# Documentation site output. docs/api holds generated YAML alongside a
# hand-written index.md, so only the generated half is ignored.
docs/_site/
docs/api/*.yml
docs/api/.manifest