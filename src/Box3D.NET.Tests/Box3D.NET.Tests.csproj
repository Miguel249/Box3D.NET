<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Box3D.NET.Tests</AssemblyName>
    <RootNamespace>Box3D.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests reach into unmanaged memory to verify struct layouts. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The library targets net8.0, which is the oldest runtime it supports. The
      tests exercise that same assembly but should run on whatever runtime the
      machine or CI image happens to have, rather than forcing a .NET 8 install.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Box3D.NET\Box3D.NET.csproj" />
    <ProjectReference Include="..\Box3D.NET.Native\Box3D.NET.Native.csproj" />
  </ItemGroup>

  <!--
    The recorded native ABI, embedded so that AbiTests runs from the test
    assembly alone, with no dependency on the working directory or on a C
    toolchain being present. tools/dump-abi.ps1 regenerates the file.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\abi\native-layout.json" LogicalName="Box3D.Tests.native-layout.json" />
  </ItemGroup>

</Project>
