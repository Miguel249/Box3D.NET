<Project>

  <!--
    Everything that depends on IsPackable belongs here rather than in
    Directory.Build.props.

    .props is imported at the top of a project, before the project body runs, so
    a condition on IsPackable there is evaluated against an empty value and never
    fires. .targets is imported at the bottom, once the project has declared
    itself. Getting this wrong is silent: the build stays green and simply stops
    generating documentation and stops running the analyzers.
  -->

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <!--
      Documentation is a build gate, not a nicety. With TreatWarningsAsErrors on,
      this turns an undocumented public member into a failed build.

      DocumentationFile is set here as well, and not left to the SDK. The SDK
      derives it from GenerateDocumentationFile inside Microsoft.NET.Sdk.targets,
      which is evaluated before this file is imported, so it reads the flag as
      empty and leaves DocumentationFile blank. A blank DocumentationFile means
      the compiler emits no CS1591 at all: the gate silently passes, and the
      packages ship without IntelliSense. Naming the file here restores both.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>

    <!--
      IsAotCompatible switches on the AOT and trim analyzers, which fail the
      build on reflection and dynamic-code patterns that would break under
      NativeAOT. It also implies IsTrimmable.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <!--
      The package must carry its own documentation rather than pointing at a
      repository the reader may not be able to reach.
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Compare every pack against the last published package.

      Once a version is on nuget.org it cannot be withdrawn, only delisted, so a
      member quietly removed or a signature quietly changed is permanent for
      anyone who already depends on it. This downloads the baseline from
      nuget.org at pack time and fails the build on a change that would break a
      consumer, across every target framework and runtime the package ships.

      Bump the baseline when a version ships. Breaking changes are allowed
      before 1.0, but they should be a decision recorded in the changelog rather
      than something discovered by a consumer.

      This was still 0.1.0 while 0.3.0 was being prepared, which is a gap rather
      than extra strictness: comparing against 0.1.0 says nothing about whether
      a member 0.2.0 added has survived, so anything introduced and then removed
      inside the 0.2.x line would have passed unremarked.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />

    <!--
      Box3D's licence travels with the package, because the package carries
      Box3D's compiled binaries. The MIT License requires its notice to
      accompany "all copies or substantial portions of the Software", and a
      redistributed box3d.dll is exactly that. PackageLicenseExpression records
      this project's own licence and does not put a file in the package, so
      without this the obligation was unmet — and LICENSE claimed otherwise.
    -->
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Wiring between the native Box3D binary and the .NET build.

    tools/build-native.ps1 stages each platform's library under
    runtimes/<rid>/native/, which is the layout NuGet resolves at run time.
    This file does two things with that folder:

      1. Packs every staged runtime into Box3D.NET.Native, so that installing
         the package on any supported platform just works.
      2. Copies the current machine's runtime next to the output of executable
         projects, so tests and samples run from a plain "dotnet test" without
         a package restore in between.

    The folder is deliberately not in source control: it is build output. A
    clone therefore has no native binary until build-native.ps1 has run, and
    the tests that need one skip themselves rather than fail.
  -->

  <PropertyGroup>
    <Box3DRuntimesDir>$(MSBuildThisFileDirectory)runtimes\</Box3DRuntimesDir>
  </PropertyGroup>

  <!--
    Pack every staged runtime into the native package.

    PackagePath names the destination file in full, down to the file name. A
    path ending in a separator would instead be read as a directory, and NuGet
    would append the item's own recursive path to it, producing a doubled
    runtimes\win-x64\native\win-x64\native\box3d.dll that resolves at run time
    on no platform at all. Naming the file explicitly keeps that ambiguity out.
  -->
  <ItemGroup Condition="'$(PackageId)' == 'Box3D.NET.Native' AND Exists('$(Box3DRuntimesDir)')">
    <None Include="$(Box3DRuntimesDir)**\*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <!--
    Copy the host runtime next to the build output.

    NativeRuntimeIdentifier resolves to the RID of the machine doing the build.
    If nothing has been staged for it the copy is simply skipped; the projects
    still build, and only the tests that call into the library are affected.
  -->
  <Target Name="CopyBox3DNativeRuntime"
          BeforeTargets="PrepareForRun"
          Condition="'$(OutputType)' == 'Exe' OR '$(IsTestProject)' == 'true'">

    <PropertyGroup>
      <_Box3DHostRid Condition="'$(_Box3DHostRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_Box3DHostRid>
      <_Box3DHostRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_Box3DHostRid>
      <_Box3DNativeDir>$(Box3DRuntimesDir)$(_Box3DHostRid)\native\</_Box3DNativeDir>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(_Box3DNativeDir)')">
      <_Box3DNativeFile Include="$(_Box3DNativeDir)*" />
    </ItemGroup>

    <Copy SourceFiles="@(_Box3DNativeFile)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_Box3DNativeFile)' != ''" />

    <Message Importance="normal"
             Condition="'@(_Box3DNativeFile)' == ''"
             Text="No native Box3D runtime staged for $(_Box3DHostRid). Run tools/build-native.ps1 to build it; tests needing the native library will be skipped." />
  </Target>

</Project>
