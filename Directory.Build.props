<Project>

  <!--
    Settings shared by every project in the repository.

    Projects opt in to packaging by setting IsPackable; the test and sample
    projects leave it off. Anything specific to a single project belongs in
    that project's .csproj, not here.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Quality gates. Documentation warnings are errors on purpose: every public
    type and member in this library is required to carry XML documentation.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Anything that has to react to IsPackable lives in Directory.Build.targets,
    not here. This file is imported at the top of every project, before the
    project body has had a chance to set IsPackable, so a condition on it here
    always reads empty. That mistake silently disabled the XML documentation
    and the AOT analyzers for the entire repository.
  -->

  <!-- Package metadata. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Box3D.NET contributors</Authors>
    <Company>Box3D.NET</Company>
    <Product>Box3D.NET</Product>
    <Copyright>Copyright (c) 2026 Box3D.NET contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/box3d-net/Box3D.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/box3d-net/Box3D.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>box3d;physics;3d;simulation;rigid-body;collision;gamedev;native;interop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Symbols and SourceLink, so stack traces from the package step into real source. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
