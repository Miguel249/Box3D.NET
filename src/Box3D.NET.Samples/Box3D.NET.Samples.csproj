<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Box3D.NET.Samples</AssemblyName>
    <RootNamespace>Box3D.Samples</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The samples double as a NativeAOT smoke test for the whole stack. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Built against net8.0, the oldest runtime the library supports, but run on
      whatever runtime is present so that the samples work on a machine that has
      only a newer one installed.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Box3D.NET\Box3D.NET.csproj" />
  </ItemGroup>

</Project>
